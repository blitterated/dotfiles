  "${LT_GREY_3} ${RESET}"


# Widget: last command duration
flyline create-prompt-widget last-command-duration

# Widget: git status
flyline create-prompt-widget custom --name PRETTY_GIT_PROMPT --command 'pretty-git-prompt' --placeholder prev

# Cursor
flyline set-cursor --backend flyline --style "#ff007f" --effect fade --effect-easing in-out-sine --interpolate-easing out-elastic --interpolate 1.33

# Prompt section divider
readonly PDIV="${LT_BLUE_2}|${RESET}"

# Blue user name
readonly FLYLINE_BLUE_USER="${BLUE_6}\u${RESET}"

# Left-side prompt
PS1="${FLYLINE_BLUE_USER} ${PDIV} ${GREEN_TERMINAL}\w${RESET} ${PDIV} \n󰶻 "

# Right-side prompt
#           git status         |    command duration              |     real-time clock
RPS1=" ${PDIV} PRETTY_GIT_PROMPT ${PDIV} FLYLINE_LAST_COMMAND_DURATION ${PDIV} ANIM_MOON ${LT_GREEN}\t${RESET}"

# Display for previous commands run

## Show dimmed timestamp
PS1_FINAL="${LT_GREY_1}[\D{%Y-%m-%d %H:%M:%S}]>${RESET}"

## Remove Right side prompt
RPS1_FINAL=''

## Draw a separator between commands
PROMPT_RULER="${LT_GREY_1}${RESET}"

# Left-side multi-line continuation prompt with line numbers
PS2="${LT_GREY_1}FLYLINE_PROMPT_LINE_NUMBER:${RESET} "

# Fill between Right-side and Left-side prompt
PS1_FILL="${GREEN_TERMINAL}~${RESET}"

# Keybinds
flyline key bind Ctrl+p always=clearBuffer+prevHistoryEntry
flyline key bind Ctrl+n always=clearBuffer+nextHistoryEntry
flyline key bind Ctrl+b always=moveLeft
flyline key bind Ctrl+f always=moveRight


