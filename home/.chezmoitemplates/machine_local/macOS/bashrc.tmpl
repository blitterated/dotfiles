########################################
# Common darwin bash + zsh config      #
########################################

{{ includeTemplate "machine_local/macOS/bash_zsh_common.sh" }}


########################################
#  Homebrew Completions                #
########################################

if type brew &> /dev/null; then

  # stash any GLOBIGNORE settings.
  globstash="${GLOBIGNORE}"
  GLOBIGNORE="git-prompt.sh" # Using Starship instead

  # Iterate over Homebrew installed completion scripts.
  # `*` will respect GLOBINGORE exclusions.
  for cf in "$(brew --prefix)/etc/bash_completion.d/"*; do
    [ -r "${cf}" ] && source "${cf}"
  done

  # Bring back previous GLOBIGNORE settings.
  GLOBIGNORE="${globstash}"

else
  errcho "Homebrew not installed. Skipping bash completions."
fi


########################################
#  Flyline                             #
########################################

{{- $fc := .flyline.color -}}
{{- includeTemplate "machine_local/macOS/relink_flyline.sh" -}}

enable -f "/opt/homebrew/lib/flyline.dylib" "flyline"

# ANSI colors
readonly WHITE_1='\e[38;5;255m'
readonly WHITE_2='\e[38;5;253m'
readonly WHITE_3='\e[38;5;251m'
readonly WHITE_4='\e[38;5;249m'
readonly LT_GREY_1='\e[38;5;247m'
readonly LT_GREY_2='\e[38;5;245m'
readonly LT_GREY_3='\e[38;5;243m'

# Animation: Moon
flyline create-prompt-widget animation --name ANIM_MOON --fps 24 \
  "${LT_GREY_3}  {{ $fc.reset }}" \
  "${LT_GREY_3} {{ $fc.reset }}" \
  "${LT_GREY_3} {{ $fc.reset }}" \
  "${LT_GREY_2} {{ $fc.reset }}" \
  "${LT_GREY_2} {{ $fc.reset }}" \
  "${LT_GREY_1} {{ $fc.reset }}" \
  "${LT_GREY_1} {{ $fc.reset }}" \
  "${WHITE_4} {{ $fc.reset }}" \
  "${WHITE_4} {{ $fc.reset }}" \
  "${WHITE_3} {{ $fc.reset }}" \
  "${WHITE_3} {{ $fc.reset }}" \
  "${WHITE_2} {{ $fc.reset }}" \
  "${WHITE_2} {{ $fc.reset }}" \
  "${WHITE_1} {{ $fc.reset }}" \
  "${WHITE_1} {{ $fc.reset }}" \
  "${WHITE_1} {{ $fc.reset }}" \
  "${WHITE_2} {{ $fc.reset }}" \
  "${WHITE_2} {{ $fc.reset }}" \
  "${WHITE_3} {{ $fc.reset }}" \
  "${WHITE_3} {{ $fc.reset }}" \
  "${WHITE_4} {{ $fc.reset }}" \
  "${WHITE_4} {{ $fc.reset }}" \
  "${LT_GREY_1} {{ $fc.reset }}" \
  "${LT_GREY_1} {{ $fc.reset }}" \
  "${LT_GREY_2} {{ $fc.reset }}" \
  "${LT_GREY_2} {{ $fc.reset }}" \
  "${LT_GREY_3} {{ $fc.reset }}" \
  "${LT_GREY_3} {{ $fc.reset }}"


# Widget: last command duration
flyline create-prompt-widget last-command-duration

# Widget: git status
flyline create-prompt-widget custom --name PRETTY_GIT_PROMPT --command 'pretty-git-prompt' --placeholder prev

# Cursor
flyline set-cursor --backend flyline --style "#ff007f" --effect fade --effect-easing in-out-sine --interpolate-easing out-elastic --interpolate 1.33

# Prompt section divider
readonly PDIV="{{ $fc.orange }}|{{ $fc.reset }}"

# Blue user name
readonly FLYLINE_USER="{{ $fc.blue }}\u{{ $fc.reset }}"

# Left-side prompt
PS1="${FLYLINE_USER} ${PDIV} {{ $fc.green }}\w{{ $fc.reset }} ${PDIV} \n󰶻 "

# Right-side prompt
#           git status         |    command duration              |     real-time clock
RPS1=" ${PDIV} PRETTY_GIT_PROMPT ${PDIV} FLYLINE_LAST_COMMAND_DURATION ${PDIV} ANIM_MOON {{ $fc.green }}\t{{ $fc.reset }}"

# Display for previous commands run

## Show dimmed timestamp
PS1_FINAL="{{ $fc.lt_grey }}[\D{%Y-%m-%d %H:%M:%S}]>{{ $fc.reset }}"

## Remove Right side prompt
RPS1_FINAL=''

## Draw a separator between commands
PROMPT_RULER="{{ $fc.lt_grey }}{{ $fc.reset }}"

# Left-side multi-line continuation prompt with line numbers
PS2="{{ $fc.lt_grey }}FLYLINE_PROMPT_LINE_NUMBER:{{ $fc.reset }} "

# Fill between Right-side and Left-side prompt
PS1_FILL="{{ $fc.green }}~{{ $fc.reset }}"

# Keybinds
flyline key bind Ctrl+p always=clearBuffer+prevHistoryEntry
flyline key bind Ctrl+n always=clearBuffer+nextHistoryEntry
flyline key bind Ctrl+b always=moveLeft
flyline key bind Ctrl+f always=moveRight


