  "${LT_GREY_3} ${RESET}" \
  "${LT_GREY_3} ${RESET}" \
  "${LT_GREY_2} ${RESET}" \
  "${LT_GREY_2} ${RESET}" \
  "${LT_GREY_1} ${RESET}" \
  "${LT_GREY_1} ${RESET}" \
